# PostgreSQL connection (manual setup — see INSTRUCTIONS.md)
DATABASE_URL="postgresql://postgres:password@localhost:5432/hymn_app?schema=public"

# API server
API_PORT=3000
API_HOST=0.0.0.0

# Optional. HTTPS origin for sheet images (S3 or CloudFront). No trailing slash.
# Object keys must match DB paths, e.g. TBC/Hymn Name/file.webp
# Leave unset to serve files from data/hymns via /api/assets/hymns/
# ASSET_BASE_URL=https://your-bucket.s3.ap-southeast-2.amazonaws.com

# Mobile app — point to your machine's local IP when testing on a physical device
EXPO_PUBLIC_API_URL=http://localhost:3000
