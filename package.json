{
  "name": "hymn-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api": "npm run dev --workspace=@hymn-app/api",
    "mobile": "npm run start --workspace=@hymn-app/mobile",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run db:push && npm run db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-file-system": "~58.0.13",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "overrides": {
    "react": "19.3.0",
    "react-native": "0.88.1",
    "@types/react": "~19.3.0",
    "react-native-screens": "4.30.1",
    "react-native-safe-area-context": "5.11.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
