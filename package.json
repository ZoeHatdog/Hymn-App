{
  "name": "hymn-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api": "npm run dev --workspace=@hymn-app/api",
    "mobile": "npm run start --workspace=@hymn-app/mobile",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run db:push && npm run db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-file-system": "~57.0.7",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2"
  },
  "overrides": {
    "react": "19.2.3",
    "react-native": "0.86.3",
    "@types/react": "~19.2.0",
    "expo": "57.0.24",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
